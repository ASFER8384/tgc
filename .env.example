# Postgres in production. PDPL: this must resolve to an in Kingdom region
# (for example AWS me-central-1) unless a cross border transfer basis is documented.
SCA_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5434/tgc_sca

# Internal console and connector auth. Placeholder for SSO and roles: buying
# approval in particular needs a real named user behind it.
SCA_API_KEY=dev-key-change-me

# Where the buying team sits. Supplier timezones are per supplier.
SCA_HOME_TIMEZONE=Asia/Riyadh

# Reordering policy, in weeks of forecast cover.
SCA_REORDER_COVER_WEEKS=4
SCA_TARGET_COVER_WEEKS=8

# Orders at or above this value need a human before they leave the building.
SCA_APPROVAL_THRESHOLD_SAR=25000

# How long a supplier may sit on an order before the system chases, and how far
# a promised date may move before it becomes an exception.
SCA_ACK_REMINDER_HOURS=24
SCA_ETA_SLIP_DAYS=3

SCA_ENV=local

# Outbound mail. Off unless set: this is the only part of the system that can
# reach someone outside the building. "console" prints the message and sends
# nothing, "smtp" actually sends.
SCA_MAIL_PROVIDER=none

# SMTP from a mailbox you already own, which needs no domain verification and,
# unlike a sending-only email platform, receives the supplier's reply.
# Gmail: smtp.gmail.com:587. Microsoft 365: smtp.office365.com:587.
SCA_MAIL_SMTP_HOST=smtp.gmail.com
SCA_MAIL_SMTP_PORT=587
SCA_MAIL_SMTP_USER=
# An app password, not the account password. Both Google and Microsoft reject
# the account password outright, with a bare 535.
SCA_MAIL_SMTP_PASSWORD=
SCA_MAIL_FROM=
SCA_MAIL_FROM_NAME=Procurement
# Where the supplier's reply should land. Leave blank to use the from address.
SCA_MAIL_REPLY_TO=

# Safety rails. The seeded suppliers have invented addresses on domains that may
# belong to real people, so one of these should always be set outside production.
# A redirect sends every message to one inbox whatever the order says.
SCA_MAIL_REDIRECT_TO=
# An allowlist refuses anything outside it. Comma separated.
SCA_MAIL_ALLOWED_DOMAINS=

# Inbound. Replies are read out of the same mailbox rather than pasted in.
# Gmail: imap.gmail.com:993. Microsoft 365: outlook.office365.com:993.
# Leave user and password blank to reuse the SMTP credentials above.
SCA_MAIL_IMAP_HOST=imap.gmail.com
SCA_MAIL_IMAP_PORT=993
SCA_MAIL_IMAP_USER=
SCA_MAIL_IMAP_PASSWORD=
SCA_MAIL_IMAP_FOLDER=INBOX
