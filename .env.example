# Postgres in production. PDPL: this must resolve to an in Kingdom region
# (for example AWS me-central-1) unless a cross border transfer basis is documented.
SCA_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5434/tgc_sca

# Internal console and connector auth. Placeholder for SSO and roles: buying
# approval in particular needs a real named user behind it.
SCA_API_KEY=dev-key-change-me

# Where the buying team sits. Supplier timezones are per supplier.
SCA_HOME_TIMEZONE=Asia/Riyadh

# Reordering policy, in weeks of forecast cover.
SCA_REORDER_COVER_WEEKS=4
SCA_TARGET_COVER_WEEKS=8

# Orders at or above this value need a human before they leave the building.
SCA_APPROVAL_THRESHOLD_SAR=25000

# How long a supplier may sit on an order before the system chases, and how far
# a promised date may move before it becomes an exception.
SCA_ACK_REMINDER_HOURS=24
SCA_ETA_SLIP_DAYS=3

SCA_ENV=local
